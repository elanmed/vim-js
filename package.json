{
  "name": "vim-js",
  "packageManager": "pnpm@11.1.0",
  "version": "0.0.1",
  "description": "A minimalist vimium",
  "scripts": {
    "install-deps": "pnpm install && pnpm exec playwright install && pnpm exec playwright install-deps",
    "gen-manifest": "node manifest/gen-manifest.js",
    "test": "playwright test",
    "test:headless": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0"
  }
}
